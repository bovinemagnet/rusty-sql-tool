# Copy this file to .env and replace the placeholders with your PostgreSQL details.
# Rusty SQL Tool reads .env but never modifies it.

# Recommended: use one PostgreSQL connection URL.
CONNECTION_NAME=Local Development
DATABASE_URL=postgresql://username:password@localhost:5432/database_name?sslmode=prefer

# Additional connections use matching suffixes and are all shown in the Connections pane.
# CONNECTION_NAME_STAGING=Staging
# DATABASE_URL_STAGING=postgresql://username:password@staging.example:5432/database_name?sslmode=require
# CONNECTION_NAME_PRODUCTION=Production Read Only
# DATABASE_URL_PRODUCTION=postgresql://readonly:password@db.example:5432/database_name?sslmode=require

# Alternatively, comment out DATABASE_URL above and use individual PostgreSQL variables.
# CONNECTION_NAME=Local Development
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=database_name
# PGUSER=username
# PGPASSWORD=password
# PGSSLMODE=prefer

# Supported SSL modes: disable, prefer, require, verify-ca, and verify-full.
